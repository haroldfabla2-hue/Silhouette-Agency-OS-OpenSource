[Unit]
Description=Finite daemon writer+owner FS contracts, no daemon import
[Service]
Type=exec
ExitType=cgroup
RemainAfterExit=yes
User=1000
Group=1000
SupplementaryGroups=
RootDirectory=@ROOT@
WorkingDirectory=/work
MountAPIVFS=no
InaccessiblePaths=/proc /sys /run
ProtectSystem=strict
ProtectHome=yes
BindPaths=@WORK@:/work @TMP@:/tmp
ReadWritePaths=/work /tmp
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
MemoryMax=536870912
MemorySwapMax=0
OOMPolicy=kill
OOMScoreAdjust=0
TasksMax=64
CPUQuota=100%
CPUQuotaPeriodSec=100ms
RuntimeMaxSec=45s
TimeoutStartSec=5s
TimeoutStopSec=2s
KillMode=control-group
Restart=no
StandardInput=null
StandardOutput=append:@TMP@/contracts.log
StandardError=append:@TMP@/contracts.log
ExecStart=/usr/bin/python3 -I -B -S /admission-pre-node.INACTIVE.py
