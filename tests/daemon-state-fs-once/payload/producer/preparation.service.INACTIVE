[Unit]
Description=Finite public locked dependencies and full types in OCI data rootfs
[Service]
Type=exec
ExitType=cgroup
RemainAfterExit=yes
User=@UID@
Group=@UID@
SupplementaryGroups=
RootDirectory=@ROOT@
WorkingDirectory=/work/source
MountAPIVFS=no
InaccessiblePaths=/proc /sys /run
ProtectSystem=strict
ProtectHome=yes
BindReadOnlyPaths=@VALIDATION@:/validation
BindPaths=@WORK@:/work
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=268435456
ReadWritePaths=/work /tmp
NetworkNamespacePath=/run/netns/@NETNS@
RestrictAddressFamilies=AF_INET
SystemCallArchitectures=native
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
MemoryMax=4294967296
MemorySwapMax=0
OOMPolicy=kill
OOMScoreAdjust=0
TasksMax=256
CPUQuota=200%
CPUQuotaPeriodSec=100ms
RuntimeMaxSec=600s
TimeoutStartSec=5s
TimeoutStopSec=5s
KillMode=control-group
Restart=no
StandardInput=null
StandardOutput=append:@WORK@/preparation.log
StandardError=append:@WORK@/preparation.log
ExecStart=/usr/bin/python3 -I -B -S /validation/online-gate.INACTIVE.py
