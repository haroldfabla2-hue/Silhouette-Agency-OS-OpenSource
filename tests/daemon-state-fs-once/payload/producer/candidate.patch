+import type { DaemonStateCustody } from './daemonStateOwner.js';
+export type DurableDaemonSnapshot = {kind: 'DAEMON_STATE_SNAPSHOT_DURABLE';
+    sequence: number; bytes: number; sha256: string; fileSynced: true; directorySynced: true};
+export type DaemonRecoveryReceipt = {kind: 'DAEMON_AGGREGATE_RECOVERY_SETTLEMENT';
+    recoverySequence: number; coveredThroughSequence: number; failureWatermark: number;
+    aggregateKind: string; ownerEpoch: number; ownerRevision: number; bytes: number;
+    sha256: string; fileSynced: true; directorySynced: true; readbackVerified: true;
+    historyErased: false; descendantWorkExhausted: false};
+export class SerializedStateWriter {
+    constructor(destination: string);
+    write(payload: string): Promise<DurableDaemonSnapshot>;
+    recoverAggregate(custody: DaemonStateCustody): Promise<DaemonRecoveryReceipt>;
+    status(): {accepted: number; latestDurableSequence: number; firstFailedSequence: number | null;
+        lastFailedSequence: number | null; failureCount: number; persistenceDebt: boolean;
+        settlement: DaemonRecoveryReceipt | null};
+    flush(): Promise<{kind: 'DAEMON_STATE_PREFIX_DURABLE'; upToSequence: number;
+        admissionStillOpen: true; persistenceDebt: false; recovery: DaemonRecoveryReceipt | null}>;
+}
diff --git a/services/daemon/serializedStateWriter.js b/services/daemon/serializedStateWriter.js
new file mode 100644
index 0000000..f81459c
--- /dev/null
+++ b/services/daemon/serializedStateWriter.js
@@ -0,0 +1,132 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import crypto from 'node:crypto';
+const hash = value => crypto.createHash('sha256').update(value).digest('hex');
+// Per-instance FIFO. Every attempt remains independent, including after errors.
+export class SerializedStateWriter {
+    constructor(destination) {
+        if (!path.isAbsolute(destination)) throw Error('DAEMON_STATE_PATH_NOT_ABSOLUTE');
+        this.destination = destination;
+        this.tail = Promise.resolve();
+        this.accepted = 0;
+        this.firstFailure = null;
+        this.lastFailureSequence = null;
+        this.failureCount = 0;
+        this.latestDurableSequence = 0;
+        this.settlement = null;
+    }
+    enqueue(operation) {
+        const result = this.tail.then(operation);
+        this.tail = result.then(() => undefined, () => undefined);
+        void result.catch(() => {});
+        return result;
+    }
+    async commit(payload, sequence) {
+        const temporary = this.destination + '.tmp-' + crypto.randomUUID();
+        let stage = 'OPEN_EXCLUSIVE', handle, temporaryCreated = false, renamed = false;
+        try {
+            handle = await fs.open(temporary, 'wx', 0o600); temporaryCreated = true;
+            stage = 'WRITE'; await handle.writeFile(payload, 'utf8');
+            stage = 'SYNC_FILE'; await handle.sync();
+            stage = 'CLOSE_FILE'; await handle.close(); handle = null;
+            stage = 'RENAME'; await fs.rename(temporary, this.destination); renamed = true;
+            stage = 'SYNC_DIRECTORY';
+            const directory = await fs.open(path.dirname(this.destination), 'r');
+            try { await directory.sync(); } finally { await directory.close(); }
+            this.latestDurableSequence = sequence;
+            return {kind: 'DAEMON_STATE_SNAPSHOT_DURABLE', sequence,
+                bytes: Buffer.byteLength(payload), sha256: hash(payload),
+                fileSynced: true, directorySynced: true};
+        } catch (cause) {
+            const error = Error('DAEMON_STATE_PERSISTENCE_FAILED');
+            Object.assign(error, {stage, sequence, cause, renameCompleted: renamed, cleanupFailures: []});
+            if (!this.firstFailure) this.firstFailure = {sequence, error};
+            this.lastFailureSequence = sequence; this.failureCount++;
+            this.settlement = null;
+            if (handle) { try { await handle.close(); } catch { error.cleanupFailures.push('CLOSE_FILE'); } }
+            if (temporaryCreated && !renamed) error.retainedTemporary = temporary;
+            throw error;
+        }
+    }
+    write(payload) {
+        if (typeof payload !== 'string') return Promise.reject(Error('DAEMON_STATE_PAYLOAD_NOT_STRING'));
+        const sequence = ++this.accepted;
+        this.settlement = null; // New custody always invalidates prior recovery.
+        return this.enqueue(() => this.commit(payload, sequence));
+    }
+    recoverAggregate(custody) {
+        const recoverySequence = ++this.accepted;
+        this.settlement = null;
+        const coveredThroughSequence = recoverySequence - 1;
+        const operation = this.enqueue(async () => {
+            const failureWatermark = this.failureCount; // Includes queued earlier failures.
+            const validate = () => {
+                custody.validate();
+                if (custody.kind !== 'DAEMON_TASK_ROSTER_COMPLETE_STATE_V1'
+                    || typeof custody.payload !== 'string' || this.accepted !== recoverySequence
+                    || this.failureCount !== failureWatermark) throw Error('DAEMON_STATE_RECOVERY_WATERMARK_CHANGED');
+            };
+            validate();
+            const durable = await this.commit(custody.payload, recoverySequence);
+            validate();
+            // Read actual committed bytes after file+directory fsync. Not just a
+            // later sequence number or a supplied previous-success receipt.
+            const actual = await fs.readFile(this.destination);
+            validate();
+            if (actual.length !== durable.bytes || hash(actual) !== durable.sha256)
+                throw Error('DAEMON_STATE_RECOVERY_READBACK_MISMATCH');
+            const receipt = Object.freeze({kind: 'DAEMON_AGGREGATE_RECOVERY_SETTLEMENT',
+                recoverySequence, coveredThroughSequence, failureWatermark,
+                aggregateKind: custody.kind, ownerEpoch: custody.epoch, ownerRevision: custody.revision,
+                bytes: durable.bytes, sha256: durable.sha256,
+                fileSynced: true, directorySynced: true, readbackVerified: true,
+                historyErased: false, descendantWorkExhausted: false});
+            this.settlement = {receipt, custody};
+            return receipt;
+        });
+        const checked = operation.catch(cause => {
+            this.settlement = null;
+            if (this.lastFailureSequence !== recoverySequence) {
+                const error = Error('DAEMON_STATE_RECOVERY_FAILED');
+                Object.assign(error, {sequence: recoverySequence, cause});
+                if (!this.firstFailure) this.firstFailure = {sequence: recoverySequence, error};
+                this.lastFailureSequence = recoverySequence; this.failureCount++;
+            }
+            throw cause;
+        });
+        void checked.catch(() => {});
+        return checked;
+    }
+    validSettlement() {
+        const value = this.settlement;
+        if (!value || value.receipt.recoverySequence !== this.accepted
+            || value.receipt.failureWatermark !== this.failureCount) return null;
+        try { value.custody.validate(); } catch { return null; }
+        return value.receipt;
+    }
+    status() {
+        return {accepted: this.accepted, latestDurableSequence: this.latestDurableSequence,
+            firstFailedSequence: this.firstFailure?.sequence ?? null,
+            lastFailedSequence: this.lastFailureSequence, failureCount: this.failureCount,
+            persistenceDebt: this.firstFailure !== null && !this.validSettlement(),
+            settlement: this.validSettlement()};
+    }
+    flush() {
+        const upToSequence = this.accepted, barrier = this.tail;
+        // Immutable historical prefix proof, captured while custody is valid.
+        // Later work invalidates current-state status, not this earlier prefix.
+        const recoveredPrefix = this.validSettlement();
+        return barrier.then(() => {
+            const failedPrefix = this.firstFailure && this.firstFailure.sequence <= upToSequence;
+            const settlement = recoveredPrefix ?? this.validSettlement();
+            if (failedPrefix && (!settlement || settlement.recoverySequence !== upToSequence)) {
+                const error = Error('DAEMON_STATE_BARRIER_HAS_UNSETTLED_FAILURES');
+                error.upToSequence = upToSequence; error.firstFailedSequence = this.firstFailure.sequence;
+                throw error;
+            }
+            return {kind: 'DAEMON_STATE_PREFIX_DURABLE', upToSequence,
+                admissionStillOpen: true, persistenceDebt: false,
+                recovery: failedPrefix ? settlement : null};
+        });
+    }
+}
