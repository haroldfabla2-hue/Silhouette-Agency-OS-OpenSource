--- /dev/null
+++ b/tests/daemon-state-writer/contracts.node.cjs
@@ -0,0 +1,125 @@
+// SOURCE-ONLY, NOT RUN. Real package ESM and actual filesystem, no mocks.
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs/promises');
+const os=require('node:os');
+const path=require('node:path');
+const crypto=require('node:crypto');
+const {pathToFileURL}=require('node:url');
+const root=path.resolve(__dirname,'../..');
+async function Writer(){
+ const pkg=JSON.parse(await fs.readFile(path.join(root,'package.json'),'utf8'));
+ assert.equal(pkg.type,'module','must run within exact real repository ESM package');
+ const actual=await import(pathToFileURL(path.join(root,'services/daemon/serializedStateWriter.js')).href);
+ assert.equal(typeof actual.SerializedStateWriter,'function');return actual.SerializedStateWriter;
+}
+const hash=x=>crypto.createHash('sha256').update(x).digest('hex');
+async function directory(fn){const dir=await fs.mkdtemp(path.join(os.tmpdir(),'daemon-writer-'));try{await fn(dir);}finally{await fs.rm(dir,{recursive:true,force:true});}}
+
+test('real ESM import and concurrent snapshots resolve FIFO, exact last bytes',()=>directory(async dir=>{
+ const Class=await Writer(),file=path.join(dir,'state.json'),writer=new Class(file),observed=[];
+ const payloads=Array.from({length:32},(_,i)=>JSON.stringify({sequence:i+1,value:String(i).repeat(65536)}));
+ const operations=payloads.map(p=>writer.write(p).then(r=>{observed.push(r.sequence);return r}));
+ const receipts=await Promise.all(operations);
