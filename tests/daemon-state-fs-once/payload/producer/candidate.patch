diff --git a/services/daemon/daemonStateOwner.js b/services/daemon/daemonStateOwner.js
new file mode 100644
index 0000000..e47cb7b
--- /dev/null
+++ b/services/daemon/daemonStateOwner.js
@@ -0,0 +1,55 @@
+// Owns only callbacks that can mutate the daemon task-state aggregate.
+// No claim about task descendants, external service work, or full shutdown.
+export class DaemonStateOwner {
+    constructor() {
+        this.accepting = true;
+        this.epoch = 0;
+        this.revision = 0;
+        this.active = new Set();
+    }
+    run(task) {
+        if (!this.accepting) return Promise.resolve({started: false, reason: 'DAEMON_STATE_ADMISSION_CLOSED'});
+        let release;
+        const ticket = new Promise(resolve => { release = resolve; });
+        this.active.add(ticket);
+        let operation;
+        try { operation = Promise.resolve(task()); }
+        catch (error) { operation = Promise.reject(error); }
+        operation.then(() => { this.active.delete(ticket); release(); },
+            () => { this.active.delete(ticket); release(); });
+        // Returned rejection stays observable; ignored native timer promise is
+        // internally handled, not an unhandled-rejection side effect.
+        void operation.catch(() => {});
+        return operation;
+    }
+    changed() { this.revision++; }
+    close() {
+        if (this.accepting) { this.accepting = false; this.epoch++; }
+    }
+    reopen() {
+        if (this.active.size) throw Error('DAEMON_STATE_OWNER_STILL_ACTIVE');
+        if (!this.accepting) { this.accepting = true; this.epoch++; }
+    }
+    async settle() {
+        if (this.accepting) throw Error('DAEMON_STATE_ADMISSION_OPEN');
+        const epoch = this.epoch;
+        await Promise.all([...this.active]);
+        if (this.accepting || this.epoch !== epoch || this.active.size) throw Error('DAEMON_STATE_SETTLEMENT_CHANGED');
+        return {kind: 'DAEMON_STATE_CALLBACKS_JOINED', epoch, revision: this.revision,
+            descendantWorkExhausted: false};
+    }
+    custody(capture) {
+        if (this.accepting || this.active.size) throw Error('DAEMON_STATE_CAPTURE_UNSAFE');
+        const epoch = this.epoch, revision = this.revision;
+        const payload = capture();
+        const validate = () => {
+            if (this.accepting || this.active.size || this.epoch !== epoch || this.revision !== revision)
+                throw Error('DAEMON_STATE_CUSTODY_CHANGED');
+        };
+        validate();
+        return {payload, epoch, revision, validate,
+            kind: 'DAEMON_TASK_ROSTER_COMPLETE_STATE_V1', descendantWorkExhausted: false};
+    }
+    status() { return {accepting: this.accepting, activeStateCallbacks: this.active.size,
+        epoch: this.epoch, revision: this.revision, descendantWorkExhausted: false}; }
+}
