:80 {
    # Serve Vite frontend bundle
    root * /usr/share/caddy
    encode gzip

    # API and WebSockets go to the Node.js backend.
    # handle (not handle_path) preserves the /v1 prefix the backend expects,
    # and handle blocks are mutually exclusive: /v1/* never reaches try_files
    # (previously try_files rewrote API paths to /index.html - same-origin API unreachable).
    handle /v1/* {
        reverse_proxy bot:3005
    }

    # Static files first, SPA fallback to index.html
    handle {
        try_files {path} /index.html
        file_server
    }
}
