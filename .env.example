# ═══════════════════════════════════════════════════════════════
# SILHOUETTE AGENCY OS — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# DO NOT COMMIT .env.local TO VERSION CONTROL.
#
# MINIMUM TO START: Add at least ONE key under "LLM Providers".
# Everything else is optional — the system degrades gracefully.
# ═══════════════════════════════════════════════════════════════

# ─── System ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3005
DEBUG=false
# Bind host (SILHOUETTE_HOST also works)
# HOST=0.0.0.0
# Instance mode: 'personal' (default) or 'agency'
# SYSTEM_MODE=personal
# Allowed web UI origin (default http://localhost:5173)
# SILHOUETTE_CORS_ORIGIN=http://localhost:5173
# Set 'true' to require Redis (default: Redis is used when REDIS_URL is set)
# USE_REDIS=true

# ─── Security Secrets (generate your own; enable sensitive modules) ───
# API key for authenticating REST/WS clients of this instance
# SILHOUETTE_API_KEY=
# Master secret for internal signing
# SYSTEM_SECRET=
# Encrypts financial vault entries at rest
# FINANCIAL_VAULT_KEY=
# Signs the browser-action audit ledger
# BROWSER_AUDIT_SIGNING_KEY=
# Dev escape hatch for insecure HTTP/credentials (default: off)
# SILHOUETTE_ALLOW_INSECURE=false

# ─── Identity & Auth ─────────────────────────────────────────
# Comma-separated list of emails that get CREATOR role on Google OAuth login.
# The first user to set up the instance always gets CREATOR role regardless.
# Optional: extra creator emails. Can also be managed from Settings > Permissions at runtime.
CREATOR_EMAILS=your_email@gmail.com

# ─── LLM Providers (AT LEAST ONE REQUIRED) ───────────────────
# The orchestrator cannot think without at least one provider.
# Free tiers are available for Gemini and Groq.

# API Key for internal services
API_KEY=

# Google Gemini — recommended, free tier available
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional overrides (defaults verified live 2026-10-13):
# GEMINI_MODEL=gemini-3.8-flash
# Per-transport overrides (W6): streaming and non-streaming quotas drain
# independently per model, so each transport gets its own optional override.
# GEMINI_STREAM_MODEL=gemini-3.1-flash-lite
# GEMINI_BACKGROUND_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq — fast inference, free tier available
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (default openai/gpt-oss-120b, verified live 2026-10-13):
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — multi-model access, free models available
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override (default nvidia/nemotron-3-super-120b-a12b:free = free tier, verified live 2026-10-13):
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# DeepSeek — coding specialist
DEEPSEEK_API_KEY=

# Minimax — optional
MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=

# Ollama — local inference, no key needed
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Communication Channels (Optional) ───────────────────────
# Choose how to interact with the orchestrator.
# If none are set, use the web UI (http://localhost:5173)
# or the REST API / WebSocket directly.

# Telegram — create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Discord — get token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# WhatsApp — uses QR code scan on first start (no token needed)

# ─── Data & Persistence (Optional — auto-degrades without) ───
# Without these, the system uses SQLite + in-memory fallbacks.
# Install via Docker: docker-compose up -d

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Redis (Persistent Cache & PubSub)
REDIS_URL=redis://localhost:6379

# ─── Media & Voice (Optional) ─────────────────────────────────
# Only needed for image/video generation and voice synthesis.

# OpenAI — DALL-E 3 image generation and TTS
OPENAI_API_KEY=

# ElevenLabs — text-to-speech and voice cloning
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Voice engine switch and provider selection
# ENABLE_VOICE_ENGINE=false
# VOICE_PROVIDER=elevenlabs
# VOICE_ID=
# MINIMAX_VOICE_API_KEY=
# Outbound voice calls (Twilio)
# SILHOUETTE_VOICE_WEBHOOK=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Replicate — image/video generation (SVD, Veo, NanoBanana)
# REPLICATE_API_TOKEN=
# VEO_MODEL_ID=google/veo-3.1
# NANOBANANA_MODEL_ID=google/nano-banana-pro

# ImagineArt — fallback image generation
# IMAGINE_ART_KEY=

# Unsplash — real stock photography
# UNSPLASH_ACCESS_KEY=

# Local voice engine (AllTalk/RVC)
# VOICE_ENGINE_URL=http://localhost:8100

# ─── Google Services (Optional) ──────────────────────────────
# Google Drive integration
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/v1/drive/callback
# GOOGLE_DRIVE_FOLDER_ID=

# Google Custom Search (for research tools)
# GOOGLE_API_KEY=
# GOOGLE_CX_ID=

# ZhipuAI — Chinese LLM (semicolon-separated key pool)
# ZHIPU_API_KEYS=key1;key2;key3
# ZHIPU_MODEL=glm-4.5-flash

# NVIDIA NIM — openai-compatible inference
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ─── More Integrations (Optional) ────────────────────────────
# NOTION_API_KEY=
# TAVILY_API_KEY=
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# GOOGLE_PLACES_API_KEY=
# GOOGLE_WORKSPACE_API_KEY=

# ─── Memory Models (Optional — identity of stored embeddings) ─
# Recorded alongside each embedding so memories stay comparable.
# MEMORY_WRITE_MODEL=gemini-embedding-001
# MEMORY_WRITE_VERSION=1
# MEMORY_QUERY_MODEL=gemini-embedding-001
# MEMORY_QUERY_VERSION=1
# MEMORY_QDRANT_MODEL=gemini-embedding-001

# ─── Advanced / Internal (rarely needed) ─────────────────────
# Override the SQLite/Postgres location
# DATABASE_URL=
# SILHOUETTE_DB_PATH=./data/silhouette.db
# Declare providers as JSON instead of individual keys
# LLM_PROVIDERS_JSON=
# Milliseconds between Neo4j reconnect attempts
# GRAPH_CONNECT_COOLDOWN_MS=5000
# Sandbox execution of generated code (default: off)
# SANDBOX_MODE=false
# Z3 symbolic verifier: reject actions when the verifier itself fails (default: off)
# Z3_FAIL_CLOSED=false
# Federated multi-instance sync
# FEDERATED_SYNC_TOKEN=
# Route telemetry through a proxy
# TELEMETRY_PROXY_URL=

# ─── Self-Evolution & GitHub Integration (Optional) ──────────
# Required only if you want the system to push code changes automatically.
GITHUB_TOKEN=
# Target repository and base branch (default base: main)
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_BASE_BRANCH=main
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=Silhouette-Agency-OS
# GITHUB_BASE_BRANCH=main

# ─── External Silhouette Brain (Optional) ────────────────────
# Connect the OS to the standalone silhouette-brain 4-Tier memory service
# (https://github.com/haroldfabla2-hue/silhouette-brain). When BRAIN_API_URL is
# set, the integration auto-enables; the OS degrades gracefully if it is down.
# BRAIN_API_URL=http://localhost:9876
# BRAIN_API_ENABLED=true
# BRAIN_API_KEY=                 # optional, only if the brain is behind an auth proxy
# BRAIN_API_TIMEOUT_MS=8000

# ─── Security ────────────────────────────────────────────────
# If set, all API requests must include this token as a Bearer header.
# STRONGLY RECOMMENDED whenever the server is reachable beyond 127.0.0.1.
# SILHOUETTE_API_TOKEN=
#
# Auth is bypassed only when NO token is set AND the server is bound to
# localhost. To allow the dangerous "no-token while bound to 0.0.0.0" mode you
# must opt in explicitly (NOT recommended):
# SILHOUETTE_ALLOW_INSECURE=false

# ─── CORS (Optional) ─────────────────────────────────────────
# Comma-separated list of allowed origins for the API. Default: http://localhost:5173 only.
# Set this whenever the browser reaches the app from a different origin than the API default,
# e.g. Vite on :3000, a reverse proxy, or a port-forwarded dev environment (GitHub Codespaces
# presents https://localhost:3000). Without it the login fails with "CORS: Origin ... not allowed".
# SILHOUETTE_CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://localhost:3000

# ─── Debug Flags (Optional) ──────────────────────────────────
# Set to any value to enable verbose logging per subsystem.
# DEBUG_CURIOSITY=1
# DEBUG_HUB_STRENGTH=1
# DEBUG_LLM_GATEWAY=1
# NO_SANDBOX=true

# [W2] Filesystem tool jail (read_file / write_file / list_files) — fail-closed.
# Writes are confined to these roots (path-delimited). Default: <app>/workspace
# SILHOUETTE_FS_WRITE_ROOTS=/opt/silhouette/workspace
# Reads: wider but still allowlisted; secret names (.env, keys, *.sqlite, .git) always denied.
# SILHOUETTE_FS_READ_ROOTS=/opt/silhouette:/tmp
# Per-call write cap in bytes (default 1048576 = 1 MiB)
# SILHOUETTE_FS_MAX_WRITE_BYTES=1048576
# Append-only JSONL audit journal of every allowed/denied decision
# SILHOUETTE_FS_AUDIT_LOG=/var/lib/silhouette/fs-audit.jsonl
# [W5] Narrative filler policy — default OFF: no regex-fabricated inner voice,
# no LLM quota burn on low-importance system noise. 'on' restores legacy.
# SILHOUETTE_NARRATIVE_FILLER=off
# LLM narration threshold (default 0.7; legacy queue was >= 0.3)
# SILHOUETTE_NARRATIVE_MIN_IMPORTANCE=0.7
# [W5b] Record-to-memory floor (default 0.3): thoughts at/above this floor are
# ALWAYS persisted raw to memory even when narration is dropped; only noise
# below the floor is dropped entirely.
# SILHOUETTE_NARRATIVE_MEMORY_FLOOR=0.3
# [W3] Anti-theater gate — strict default: plans declaring file work with zero
# verified writes report FAILURE, never simulated COMPLETE. 'off' disables.
# SILHOUETTE_ANTI_THEATER=strict
